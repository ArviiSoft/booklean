{
  "name": "booklean",
  "version": "1.4.0",
  "private": true,
  "description": "Romanınız için sakin bir çalışma odası.",
  "author": "Booklean",
  "repository": {
    "type": "git",
    "url": "https://github.com/ArviiSoft/booklean.git"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win portable --x64"
  },
  "dependencies": {
    "@tiptap/core": "^3.0.0",
    "@tiptap/extension-highlight": "^3.0.0",
    "@tiptap/extension-image": "^3.0.0",
    "@tiptap/extension-placeholder": "^3.0.0",
    "@tiptap/extension-text-align": "^3.0.0",
    "@tiptap/extension-text-style": "^3.0.0",
    "@tiptap/pm": "^3.0.0",
    "@tiptap/react": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "docx": "^9.5.1",
    "dompurify": "^3.2.6",
    "iconv-lite": "^0.7.3",
    "jszip": "^3.10.1",
    "linkedom": "^0.18.12",
    "lucide-react": "^1.66.0",
    "mammoth": "^1.10.0",
    "marked": "^18.1.2",
    "papaparse": "^5.5.3",
    "pdf-parse": "2.4.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sanitize-html": "^2.17.0",
    "turndown": "^7.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.0.12",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "com.booklean.desktop",
    "productName": "Booklean",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "afterPack": "scripts/after-pack.cjs",
    "asar": true,
    "win": {
      "target": "portable",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "Booklean-${version}-portable.exe"
    }
  }
}
